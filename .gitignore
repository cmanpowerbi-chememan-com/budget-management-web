# Secrets — never commit
.env
.mcp.json
local.settings.json

# Large media files
*.mp4
*.mov
*.avi

# Test scratch output (live integration runs)
backend/integration_result.txt

# Python
__pycache__/
*.py[cod]
*.pyo
venv/
.venv/
*.egg-info/

# VS Code
.vscode/

# OS
.DS_Store
Thumbs.db

# Streamlit
.streamlit/secrets.toml

# Excel temp files
~$*.xlsx

# Claude Code local settings — track plan + project-context; ignore machine-local rest
.claude/*
!.claude/plan.md
!.claude/project-context.md

# Unrelated projects nested here
cman-prd-ingest-backend/

# Local demo/reference data — not needed in repo
# docs/  ← ชั่วคราว: uncomment เพื่อให้ @ ref ใน Claude Code ได้

# Archived/moved-out files (recoverable from git history; kept on disk only)
bin/
# Playwright stored auth state (transient, never commit)
.playwright_auth.json
# Easy Auth session cookie pasted in by hand for the prod harnesses
# (setup/smoke_prd.py, phase2_harness_*.py) — a LIVE credential, never commit
setup/_auth_cookie*.tmp.txt
# Throwaway UI review screenshots rendered for a visual sign-off
noscope-*.png

# Large source/demo data dumps (xlsx/csv/SAP exports) — not source, exceed GitHub limits
docs/demo_data/
docs/13Template Special/

# az acr build contexts — full copies of the repo tree, regenerated on every build.
# Left behind they bloat the workspace and make git status / the VS Code file watcher crawl.
.build-ctx-*/

# Pre-edit snapshots the SIT workbook editor writes before every pass
# (setup/fill_sit_test_case_gaps.py). 38 of them already, ~3 MB of binary
# churn; the live file lives on SharePoint and the edited copy is committed,
# so these are local safety copies only.
requirement_spec/4_sit/*_before_*.xlsx

# Stray npm/Next artifacts at the REPO ROOT. The real app lives in frontend/
# (which has its own .gitignore), so anything here is the residue of an npx or
# next command accidentally run one directory up. Ignored rather than tolerated
# because a single `git add -A` on an unignored node_modules is exactly how
# .git reached 1 GB once before.
/node_modules/
/.next/
/out/
