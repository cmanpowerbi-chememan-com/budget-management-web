# Copy to backend/.env for local dev. Never commit backend/.env (gitignored via root .gitignore).

# local = enables DEV_AUTH_EMAIL override in app/auth.py; anything else behaves like production
# (missing Easy Auth header -> 401). Default if unset is "production" (fail-closed).
APP_ENV=local

# Only read when APP_ENV=local. Stands in for the Easy Auth header
# (x-ms-client-principal-name) that Container Apps injects in real deployments.
DEV_AUTH_EMAIL=you@chememan.com

# --- Fabric SQL Database (ONE DB, budget.* + dbo.* schemas — ADR-0023) ---
# IMPORTANT: as of this increment the repo-root .env still points FABRIC_SQL_DATABASE at the
# RETIRED app DB1 (`budget_management_web` / db id 036a3270). Before this backend is used against
# a real DB, re-point these two to the DW SQL DB `fabric_sql_database` (the same one
# NB_employee_sync.py writes to) — get the exact FQDN from the DATA team, do not invent a host.
FABRIC_SQL_SERVER=<fabric-sql-database-host>.database.fabric.microsoft.com,1433
FABRIC_SQL_DATABASE=fabric_sql_database

# --- SAP gold warehouse (read-only, separate connection — query contract is A4, not here) ---
GOLD_SQL_SERVER=<gold-warehouse-host>.datawarehouse.fabric.microsoft.com,1433
GOLD_SQL_DATABASE=cman_dw_wh_gold

# --- Service Principal cman-fabric-write (DB auth) ---
ENTRA_CLIENT_ID=<client-id>
ENTRA_CLIENT_SECRET=<client-secret>
ENTRA_TENANT_ID=<tenant-id>

# --- Admin overlay (ADR-0012/0014) ---
# Comma-separated emails granted is_admin in GET /scope. jakkaritw is an
# external full admin with no employee-master row.
ADMIN_EMAILS=jakkaritw@chememan.com
