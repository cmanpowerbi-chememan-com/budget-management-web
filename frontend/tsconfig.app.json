{
  "compilerOptions": {
    "tsBuildInfoFile": "./node_modules/.tmp/tsconfig.app.tsbuildinfo",
    "target": "es2023",
    "lib": ["ES2023", "DOM"],
    "module": "esnext",
    "types": ["vite/client"],
    "allowArbitraryExtensions": true,
    "resolveJsonModule": true,
    "skipLibCheck": true,
    "strict": true,

    /* Bundler mode */
    "moduleResolution": "bundler",
    "allowImportingTsExtensions": true,
    "verbatimModuleSyntax": true,
    "moduleDetection": "force",
    "noEmit": true,
    "jsx": "react-jsx",

    /* Linting */
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "erasableSyntaxOnly": true,
    "noFallthroughCasesInSwitch": true
  },
  "include": ["src"],
  // Production build only (tsc -b -> vite build, run inside the Docker image
  // where docs/ is NOT in the build context — see .dockerignore). Test files
  // are never shipped and some (glDropdownConstants.test.ts) import a fixture
  // from outside frontend/, which only resolves in the full repo checkout.
  // Vitest is unaffected: it discovers/type-transpiles tests via its own
  // `test.include`/`test.exclude` globs in vite.config.ts, not this file's
  // include/exclude (verified — see frontend build fix report).
  "exclude": [
    "src/**/*.test.ts",
    "src/**/*.test.tsx",
    "src/**/*.spec.ts",
    "src/**/*.spec.tsx",
    "src/test/**",
    "e2e/**"
  ]
}
